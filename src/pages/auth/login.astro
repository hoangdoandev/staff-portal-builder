---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="ログイン">
  <main class="mx-auto max-w-384px p-16px pc:p-40px">
    <h1 class="mb-24px text-title-page font-semibold">ログイン</h1>
    <form action="#" method="post" class="space-y-16px">
      <label class="block">
        <span class="mb-4px block text-caption text-ink-sub">メールアドレス</span>
        <input type="email" name="email" class="field" />
      </label>
      <label class="block">
        <span class="mb-4px block text-caption text-ink-sub">パスワード</span>
        <input
          type="password"
          name="password"
          data-password-input
          class="field"
          aria-invalid="true"
        />
        <span class="mt-4px block text-caption-sm text-danger-sub">
          パスワードを入力してください
        </span>
      </label>
      <button type="button" data-password-toggle class="link text-body-sm">
        パスワードを表示
      </button>
      <div class="flex gap-12px">
        <button type="button" class="btn-outline flex-1">
          保存
        </button>
        <button type="submit" class="btn-primary flex-1">
          ログイン
        </button>
      </div>
      <button type="submit" disabled class="btn-primary w-full">
        提出する
      </button>
    </form>
    <p class="mt-24px inline-block rounded-pill bg-surface-pill px-8px text-caption-sm leading-copy">
      配点 20%
    </p>
  </main>
  <script is:inline type="module" src="/assets/js/pages/auth-login.js"></script>
</BaseLayout>
