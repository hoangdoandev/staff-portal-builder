---
/**
 * 自己評価一覧 (Figma PC 606:4686, SP 606:3858).
 * Mỗi kỳ đánh giá là một thẻ gồm các mục ngăn bằng đường kẻ: 対象期間, 提出期限, (kỳ đang mở) 自己評価の進捗 và link nhập.
 * Dữ liệu dưới đây là nội dung mẫu theo thiết kế, BE thay bằng dữ liệu thật.
 */
import Breadcrumb from '../../components/Breadcrumb.astro';
import PageTabs from '../../components/PageTabs.astro';
import PageTitle from '../../components/PageTitle.astro';
import PageLayout from '../../layouts/PageLayout.astro';

interface EvaluationPeriod {
  name: string;
  range: string;
  deadline: string;
  remaining: string;
  /** Kỳ đã kết thúc: hạn nộp hiện màu xám, không có tiến độ và link nhập. */
  closed?: boolean;
  progress?: { percent: number; summary: string };
  inputHref?: string;
}

const periods: EvaluationPeriod[] = [
  {
    name: '2026年度 上期',
    range: '2026年4月1日〜9月30日',
    deadline: '2026年10月7日（水）',
    remaining: 'あと16日',
    progress: { percent: 67, summary: '3項目中 2項目を入力済' },
    inputHref: '#',
  },
  {
    name: '2025年度 下期',
    range: '2025年10月1日〜3月31日',
    deadline: '評価期間終了',
    remaining: 'あと16日',
    closed: true,
  },
];
---

<PageLayout title="自己評価一覧｜人事評価">
  <Breadcrumb items={[{ label: 'HOME', href: '/' }, { label: '人事評価' }]} />
  <PageTitle title="人事評価" backHref="/" />
  <PageTabs
    label="人事評価の種類"
    items={[
      { label: '自己評価', href: '/evaluation/self.html', current: true, count: 1 },
      { label: '部下の評価', href: '#' },
    ]}
  />

  <ul class="mx-10px mb-40px mt-30px flex flex-col gap-15px pc:(mx-auto mt-50px w-580px)">
    {periods.map((period) => (
      <li class="rounded-base border border-line bg-white px-14px pc:px-19px">
        <dl class="divide-y divide-line-hair">
          <div class="pb-14px pt-12px pc:pt-16px">
            <dt class="tag">対象期間</dt>
            <dd class="mt-6px flex items-center justify-between gap-10px">
              <span class="shrink-0 text-body font-semibold">{period.name}</span>
              <span class="text-right text-caption text-ink-sub">{period.range}</span>
            </dd>
          </div>
          <div class="pb-14px pt-15px">
            <dt class="tag">提出期限</dt>
            <dd class="mt-6px flex items-center justify-between gap-10px">
              <span
                class:list={[
                  'text-body font-semibold',
                  period.closed ? 'text-ink-disabled' : 'text-danger',
                ]}
              >
                {period.deadline}
              </span>
              <span class="text-right text-caption text-ink-sub">{period.remaining}</span>
            </dd>
          </div>
          {period.progress && (
            <div class="pb-15px pt-15px">
              <dt class="tag">自己評価の進捗</dt>
              <dd class="mt-7px pc:mt-5px">
                <div class="flex items-center gap-10px pc:gap-11px">
                  <div
                    role="progressbar"
                    aria-label="自己評価の進捗"
                    aria-valuemin="0"
                    aria-valuemax="100"
                    aria-valuenow={period.progress.percent}
                    class="h-5px flex-1 overflow-hidden rounded-bar bg-surface-track pc:h-6px"
                  >
                    <div
                      class="h-full rounded-bar bg-primary"
                      style={`width: ${period.progress.percent}%`}
                    />
                  </div>
                  <span class="flex items-baseline text-figure font-semibold text-primary">
                    {period.progress.percent}
                    <span class="text-figure-unit font-normal">%</span>
                  </span>
                </div>
                <p class="text-right text-caption text-ink-sub pc:mt-4px">
                  {period.progress.summary}
                </p>
              </dd>
            </div>
          )}
        </dl>
        {period.inputHref && (
          <div class="border-t border-line-hair pb-13px pt-10px text-center pc:(pb-14px pt-15px)">
            <a href={period.inputHref} class="link text-body">
              自己評価を入力する
            </a>
          </div>
        )}
      </li>
    ))}
  </ul>
</PageLayout>
